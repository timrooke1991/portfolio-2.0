# Strava API (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# Must match the app's Authorization Callback Domain (e.g. localhost)
STRAVA_REDIRECT_URI=http://localhost

# Optional tuning
STRAVA_YEAR_GOAL_MI=2000
STRAVA_YEAR_LABEL=toward Chicago
STRAVA_ATHLETE_URL=https://www.strava.com/athletes/12160480

# GitHub contributions (public scrape — no token required)
GITHUB_USERNAME=timrooke1991
GITHUB_PROFILE_URL=https://github.com/timrooke1991
GITHUB_FIRST_YEAR=2013

# Strava history window
STRAVA_FIRST_YEAR=2013

# Netlify scheduled rebuild (or run: npm run netlify:setup-stats-hook)
NETLIFY_BUILD_HOOK=
